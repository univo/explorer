{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "explorer",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-01-20",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"dev": {
		"port": 3001
	},
	"placement": {
		"region": "aws:us-east-1"
	},
	"limits": {
		"cpu_ms": 300000
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"vars": {
		"LOG_LEVEL": "DEBUG",
		"ENVIRONMENT": "DEVELOPMENT"
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/rsc/*", "/_serverFn/*"]
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "explorer-staging"
		}
	],
	"hyperdrive": [
		{
			"binding": "PG",
			"id": "2ee0a71e78274194901a2ff23ee5c1fc",
			"localConnectionString": "WILL_OVERRIDE"
		}
	],
	"env": {
		"production": {
			"vars": {
				"LOG_LEVEL": "WARN",
				"ENVIRONMENT": "PRODUCTION"
			},
			"route": {
				"custom_domain": true,
				"pattern": "explorer.univo.app"
			},
			"r2_buckets": [
				{
					"remote": true,
					"binding": "BUCKET",
					"bucket_name": "explorer-production"
				}
			],
			"hyperdrive": [
				{
					"binding": "PG",
					"id": "6aff50d6adf14ddfb68322477e615129"
				}
			]
		}
	}
}
