{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "explorer",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-01-20",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"dev": {
		"port": 3001
	},
	"placement": {
		"region": "aws:us-east-1"
	},
	"limits": {
		"cpu_ms": 300000
	},
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"vars": {
		"LOG_LEVEL": "DEBUG",
		"ENVIRONMENT": "DEVELOPMENT"
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/rsc/*", "/_serverFn/*"]
	},
	"kv_namespaces": [
		{
			"binding": "KV",
			"remote": false,
			"id": "ac571cf2f7d1406094a410e5049869cc"
		}
	],
	"env": {
		"staging": {
			"vars": {
				"LOG_LEVEL": "DEBUG",
				"ENVIRONMENT": "STAGING"
			},
			"route": {
				"custom_domain": true,
				"pattern": "staging.explorer.univo.app"
			},
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "ac571cf2f7d1406094a410e5049869cc"
				}
			]
		},
		"production": {
			"vars": {
				"LOG_LEVEL": "DEBUG",
				"ENVIRONMENT": "PRODUCTION"
			},
			"route": {
				"custom_domain": true,
				"pattern": "explorer.univo.app"
			},
			"kv_namespaces": [
				{
					"binding": "KV",
					"id": "afc3318c48b14b9ba0cda4daa7901add"
				}
			]
		}
	}
}
