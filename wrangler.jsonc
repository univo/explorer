{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "explorer",
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-01-20",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"dev": {
		"port": 3001
	},
	"placement": {
		"region": "aws:us-east-1"
	},
	"limits": {
		"cpu_ms": 300000
	},
	"observability": {
		"logs": {
			"enabled": false,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"vars": {
		"LOG_LEVEL": "DEBUG",
		"ENVIRONMENT": "DEVELOPMENT"
	},
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/rsc/*", "/_serverFn/*"]
	},
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "explorer-staging"
		}
	],
	"env": {
		"staging": {
			"vars": {
				"LOG_LEVEL": "DEBUG",
				"ENVIRONMENT": "STAGING"
			},
			"route": {
				"custom_domain": true,
				"pattern": "staging.explorer.univo.app"
			},
			"r2_buckets": [
				{
					"remote": true,
					"binding": "BUCKET",
					"bucket_name": "explorer-staging"
				}
			]
		},
		"production": {
			"vars": {
				"LOG_LEVEL": "DEBUG",
				"ENVIRONMENT": "PRODUCTION"
			},
			"route": {
				"custom_domain": true,
				"pattern": "explorer.univo.app"
			},
			"r2_buckets": [
				{
					"remote": true,
					"binding": "BUCKET",
					"bucket_name": "explorer-production"
				}
			]
		}
	}
}
